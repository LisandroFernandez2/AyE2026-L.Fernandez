int funcionsalario(int horas)
{
    int salariototal = 0;
    int horasextra = 0;
    if (horas <= 40)
    {
        salariototal = 16 * horas;
        Console.WriteLine("El pago es de " + salariototal + " pesos");
        return salariototal;
    }
    else if (horas > 40)
    {
        horasextra = horas - 40;
        salariototal = 16 * (horas - horasextra) + 12 * horasextra;
        Console.WriteLine("El pago es de " + salariototal + " pesos");
        return salariototal;
    }
    return salariototal;
}


int sumanumeros()
{
    bool sigue = true;
    int acum = 0;
    while (sigue)
    {
        Console.WriteLine("Ingrese un numero, si quiere finalizar la funcion, ingrese 0");
        try
        {
            int numero = Convert.ToInt32(Console.ReadLine());
            if (numero != 0)
            {
                acum = acum + numero;

            }
            else if (numero == 0)
            {
                Console.WriteLine("La suma de los numeros ingresados es de " + acum);
                sigue = false;
                return acum;
            }
        }
        catch (System.FormatException)
        {

        }
    }
    return acum;
}
sumanumeros();

